{
    "name": "1337 IMDB",
    "description": "Gets the IMDB rating for 1337 Website for the Movies tab",
    "version": "1.1",
    "manifest_version": 3,
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "128": "/images/icon128.png"
        }
    },
    "icons": {
        "128": "/images/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "*://1337x.to/*",
                "*://www.1337x.to/*",
                "*://1337xx.to/*",
                "*://www.1337xx.to/*",
                "*://www.1377x.to/*",
                "*://1337x.st/*",
                "*://1337x-official.com/*",
                "*://1337x.pages.dev/*",
                "*://www.1337x.tw/*",
                "*://www.1337x.pro/*",
                "*://www.1377x.is/*",
                "*://1337x.torrentbay.st/*",
                "*://1337x.torrentsbay.org/*",
                "*://1337x.proxyninja.org/*",
                "*://1337x.proxyninja.net/*",
                "*://1337x.unblockninja.com/*"
            ],
            "js": [
                "libraries/fuzzyset.js",
                "utils/groupBy.js",
                "utils/promiseTimeout.js",
                "content-script.js"
            ]
        }
    ],
    "host_permissions": ["https://www.imdb.com/*", "https://v3.sg.media-imdb.com/*", "https://graphql.imdb.com/*"]
}